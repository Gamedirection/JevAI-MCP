{
  "name": "jevai-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "JevAI-MCP -  internal MCP server that connects AI coding agents to the Jev decision model through DefAPI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "start": "node apps/server/dist/server.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
      "lint": "eslint .",
      "clean": "node scripts/clean.mjs",
      "generate:integrations": "node scripts/generate-integrations.mjs",
      "backup": "node scripts/backup.mjs",
      "restore": "node scripts/restore.mjs",
      "helm:lint": "helm lint helm/jevai-mcp --set jevaiApiKey=dk-placeholder",
      "helm:template": "helm template jevai helm/jevai-mcp --set jevaiApiKey=dk-placeholder"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/node": "^24.19.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.30.0",
    "hono": "^4.13.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "better-sqlite3@12.11.1": true
  }
}
