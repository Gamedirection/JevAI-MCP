# JevAI-MCP environment configuration
# Copy to .env and edit. Every value here is optional; the server starts with
# safe defaults. Environment variables take precedence over values saved in
# the dashboard Settings page. Keep each value on its own line; do not add an
# inline comment after a value.

# ---------------------------------------------------------------------------
# Jev / TypeSafe connection
# Get a key from https://console.typesafe.ai. The key is never logged and
# never displayed in full. If you save it through the dashboard instead, it
# is stored as a hash.
# ---------------------------------------------------------------------------
DEFAPI_API_KEY=
# API gateway base URL. The server POSTs to {endpoint}/systemone.
DEFAPI_API_ENDPOINT=https://api.typesafe.ai/v1
# Decision model identifier. Valid values: jev-latest, jev-1.13.0, jev-preview.
JEV_MODEL=jev-1.13.0

JEV_TIMEOUT_MS=10000
JEV_RETRIES=3
JEV_RETRY_BASE_DELAY_MS=300
JEV_RETRY_MAX_DELAY_MS=5000

# ---------------------------------------------------------------------------
# Backup Jev credentials
# Tried in order after the primary, when the primary returns an auth failure
# (401 or 403) or a rate limit (429). Any other failure, such as a 404 or a
# bad request, is reported without touching a backup, because a second key
# cannot fix it.
#
# A key only works at the endpoint that issued it, so set the endpoint and the
# model for every backup. To use a second TypeSafe key, repeat the endpoint and
# model above. To use a DefAPI key, set the endpoint to
# https://api.defapi.org/v1 and use a model DefAPI actually serves.
#
# Leave a whole block blank to skip it. Slot 2 is tried before slot 3.
# ---------------------------------------------------------------------------
JEV_BACKUP_2_ENDPOINT=
JEV_BACKUP_2_MODEL=
JEV_BACKUP_2_API_KEY=
JEV_BACKUP_3_ENDPOINT=
JEV_BACKUP_3_MODEL=
JEV_BACKUP_3_API_KEY=

# ---------------------------------------------------------------------------
# Fallback chain: Jev -> local model -> cloud model
# Used only when the Jev call fails. Fallback answers are uncalibrated, so
# they carry no confidence and are tagged source=local_llm or cloud_llm in the
# response. Treat them as advisory. The original Jev failure is preserved in
# jev_error and in the request log.
# ---------------------------------------------------------------------------
JEV_FALLBACK_ENABLED=false
# Local first choice. Any OpenAI-compatible /chat/completions endpoint works,
# including Ollama. Leave blank to skip this step.
JEV_LOCAL_API_URL=
JEV_LOCAL_MODEL=
JEV_LOCAL_TIMEOUT_MS=20000
# Cloud last resort. Runs only if the local model fails or times out.
JEV_CLOUD_API_URL=
JEV_CLOUD_MODEL=
JEV_CLOUD_API_KEY=
JEV_CLOUD_TIMEOUT_MS=25000

# ---------------------------------------------------------------------------
# HTTP server: dashboard + API + MCP on one port
# ---------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Standalone MCP server: a second, dedicated MCP-only port
# ---------------------------------------------------------------------------
MCP_ENABLED=true
MCP_HOST=0.0.0.0
MCP_PORT=3001

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite database file. In Docker this is /data/jevai.db.
DATABASE_PATH=./data/jevai.db
# Optional folder for prebuilt dashboard assets. Usually left unset.
# WEB_DIR=

# DATA_RETENTION_DAYS: 0 keeps request records until you delete them.
DATA_RETENTION_DAYS=365
LOG_RETENTION_DAYS=14
LOG_MAX_FILE_BYTES=10000000

# REQUEST_STATE_STORAGE: off | metadata_only | full
#   off            store nothing about the request content
#   metadata_only  store sizes and counts only (default)
#   full           store the exact state sent to Jev
REQUEST_STATE_STORAGE=metadata_only
STORE_JEV_RESPONSES=true

# ---------------------------------------------------------------------------
# Logging: debug | info | warn | error
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Dashboard and metrics
# ---------------------------------------------------------------------------
TOKEN_SAVINGS_ENABLED=true
# ESTIMATED_AVOIDED_TOKENS: estimated context tokens avoided per decision.
ESTIMATED_AVOIDED_TOKENS=1500
# DEFAULT_TIME_RANGE: today | 7d | 30d | month | year | custom
DEFAULT_TIME_RANGE=7d
# REFRESH_INTERVAL_SECONDS: 0 disables dashboard auto-refresh.
REFRESH_INTERVAL_SECONDS=30

# ---------------------------------------------------------------------------
# Integration URLs, written into every downloadable agent configuration.
# Agents connect to {PUBLIC_PROTOCOL}://{PUBLIC_HOSTNAME}:{PUBLIC_MCP_PORT}/mcp
# ---------------------------------------------------------------------------
PUBLIC_PROTOCOL=http
PUBLIC_HOSTNAME=localhost
PUBLIC_MCP_PORT=3001
